    "lucide-react": "^0.561.0",
    "next": "16.2.12",
    "next-i18next": "^15.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^15.7.4",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
