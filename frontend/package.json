    "analyze:browser": "dotenv BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "cross-env TEST=true npx cypress run --e2e",
    "test": "yarn cypress",
    "test:coverage": "yarn cypress:headless",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
