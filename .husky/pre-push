# Backend unit tests must pass before pushing (mirrors web-app-starter's pre-push gate).
# Frontend/admin only have interactive Cypress specs, so they stay out of this hook and
# run in CI (.github/workflows/cypress*.yml).
# Bypass (discouraged): git push --no-verify

set -e

echo "→ backend: unit tests (vitest)"
yarn --cwd backend test

echo "✓ pre-push checks passed"
